{
    "description": "Glob patterns excluded from AI diffs to avoid wasting tokens on lockfiles, minified assets, and generated files.",
    "excludes": [
        "*.lock",
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "composer.lock",
        "poetry.lock",
        "Pipfile.lock",
        "Gemfile.lock",
        "go.sum",
        "*.min.js",
        "*.min.css",
        "*.svg",
        "bun.lockb",
        "bun.lock",
        "npm-shrinkwrap.json",
        "uv.lock",
        "Cargo.lock",
        "mix.lock",
        "pubspec.lock",
        "Podfile.lock",
        "Package.resolved",
        "packages.lock.json",
        "gradle.lockfile",
        "conan.lock",
        "*.bundle.js",
        "*.bundle.css",
        "*.map",
        "*.log",
        "*.pyc",
        "*.pyo",
        ".DS_Store",
        "Thumbs.db"
    ]
}